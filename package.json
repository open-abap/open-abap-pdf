{
  "name": "open-abap-pdf",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone PDF generation in ABAP",
  "main": "index.js",
  "scripts": {
    "lint": "abaplint",
    "unit": "node -e \"require('fs').rmSync('output', { recursive: true, force: true })\" && abap_transpile && echo RUNNING && node --expose-gc output/index.mjs && echo OK",
    "demo": "npm run test && node test/demo.mjs",
    "test": "npm run lint && npm run unit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-abap/open-abap-pdf.git"
  },
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/open-abap/open-abap-pdf/issues"
  },
  "homepage": "https://github.com/open-abap/open-abap-pdf#readme",
  "dependencies": {
    "@abaplint/cli": "^2.120.42",
    "@abaplint/runtime": "^2.13.74",
    "@abaplint/transpiler-cli": "^2.13.74"
  }
}
